{
  "name": "@yusheng-zhu12/dsh-workspace-memory",
  "version": "0.2.1",
  "description": "Workspace-scoped durable memory for DeepSeek Harness: readable Markdown notes in the workspace plus an automatically injected index for later conversations.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "docs/*.png",
    "docs/*.svg",
    "README.md",
    "PUBLISHING.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "node --test",
    "pack": "pnpm pack"
  },
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.2-rc.1"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "plugin",
    "memory",
    "workspace",
    "context",
    "agents-md"
  ],
  "license": "MIT",
  "author": "yusheng-zhu12",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yusheng-zhu12/dsh-workspace-memory.git"
  },
  "homepage": "https://github.com/yusheng-zhu12/dsh-workspace-memory#readme",
  "bugs": {
    "url": "https://github.com/yusheng-zhu12/dsh-workspace-memory/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
